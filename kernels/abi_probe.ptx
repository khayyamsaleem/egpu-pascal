// CUDA-module ABI probe for nvpascal: local memory (stack) via generic pointers, the shared
// window, and an initialized .global table reached by address (module data + relocations).
// out[0] = generic &lbuf, out[1] = generic &sbuf, out[2] = lbuf[idx] round trip (0x1234 + idx),
// out[3] (u32) = gtab[idx].  pascal/test_modules.py checks it.
.version 6.3
.target sm_61
.address_size 64
.global .align 4 .u32 gtab[4] = {11, 22, 33, 44};
.visible .entry abi_probe(.param .u64 out, .param .u32 idx)
{
  .reg .b64 %rd<16>;
  .reg .b32 %r<4>;
  .local .align 8 .b8 lbuf[64];
  .shared .align 8 .b8 sbuf[16];
  ld.param.u64 %rd1, [out];
  ld.param.u32 %r1, [idx];
  mov.u64 %rd2, lbuf;
  cvta.local.u64 %rd3, %rd2;
  mov.u64 %rd4, sbuf;
  cvta.shared.u64 %rd5, %rd4;
  st.global.u64 [%rd1], %rd3;
  st.global.u64 [%rd1+8], %rd5;
  mul.wide.u32 %rd6, %r1, 8;
  add.u64 %rd7, %rd3, %rd6;
  cvt.u64.u32 %rd8, %r1;
  add.u64 %rd8, %rd8, 0x1234;
  st.u64 [%rd7], %rd8;
  add.u64 %rd9, %rd2, %rd6;
  ld.local.u64 %rd10, [%rd9];
  st.global.u64 [%rd1+16], %rd10;
  mov.u64 %rd11, gtab;
  mul.wide.u32 %rd12, %r1, 4;
  add.u64 %rd13, %rd11, %rd12;
  ld.global.u32 %r2, [%rd13];
  st.global.u32 [%rd1+24], %r2;
  ret;
}

// IEEE reciprocal/division: ptxas expands rcp.rn/div.rn on sm_6x with literals in the per-kernel
// constant bank 2 (.nv.constant2.<kernel>); an unbound bank 2 returns 0.0 for every element.
// out[i] = 1/a[i], out[n+i] = a[i]/b[i]
.visible .entry fdiv_probe(.param .u64 out, .param .u64 a, .param .u64 b, .param .u32 n)
{
  .reg .pred %p<2>;
  .reg .b32 %r<4>;
  .reg .f32 %f<6>;
  .reg .b64 %rd<12>;
  ld.param.u64 %rd1, [out];
  ld.param.u64 %rd2, [a];
  ld.param.u64 %rd3, [b];
  ld.param.u32 %r1, [n];
  mov.u32 %r2, %tid.x;
  setp.ge.u32 %p1, %r2, %r1;
  @%p1 bra DONE;
  mul.wide.u32 %rd4, %r2, 4;
  add.u64 %rd5, %rd2, %rd4;
  add.u64 %rd6, %rd3, %rd4;
  ld.global.f32 %f1, [%rd5];
  ld.global.f32 %f2, [%rd6];
  rcp.rn.f32 %f3, %f1;
  div.rn.f32 %f4, %f1, %f2;
  add.u64 %rd7, %rd1, %rd4;
  st.global.f32 [%rd7], %f3;
  mul.wide.u32 %rd8, %r1, 4;
  add.u64 %rd9, %rd7, %rd8;
  st.global.f32 [%rd9], %f4;
DONE:
  ret;
}
