+class _HostScaledEmbedding(Module):
+    """[egpu-pascal] The per-layer embedding (PLE) table kept in host memory.
+
+    E2B/E4B's PLE table is 2.35B/2.82B parameters (4.7/5.6 GB in bf16), but each
+    token reads one 8960/10752-wide row, so the lookup runs on the CPU and only
+    the gathered rows go to the GPU. Same weight name as ScaledWordEmbedding, so
+    checkpoint loading is unchanged. Opt out with GEMMA4_PLE_ON_HOST=0.
+    """
+
+    def __init__(
+        self,
+        vocab_size: int,
+        hidden_dim: int,
+        dtype: DType,
+        devices: list[DeviceRef],
+        embed_scale: float = 1.0,
+    ) -> None:
+        super().__init__()
+        self.weight = Weight(
+            "weight", dtype, [vocab_size, hidden_dim], device=DeviceRef.CPU()
+        )
+        self.devices = devices
+        self.embed_scale = embed_scale
+
+    def __call__(
+        self, indices: TensorValue, signal_buffers: Sequence[BufferValue]
+    ) -> list[TensorValue]:
+        idx = ops.transfer_to(TensorValue(indices), DeviceRef.CPU())
+        rows = ops.gather(self.weight, idx, axis=0)
+        return [
+            ops.transfer_to(rows, device) * float(self.embed_scale)
+            for device in self.devices
+        ]
+
+
