+def _int8_quantize_declared(
+    language_model: Gemma4TextModel, state_dict: Mapping[str, WeightData]
+) -> Mapping[str, WeightData]:
+    """maxpatch (MAX_GEMMA4_INT8=1): RTN-quantize the bf16 weights of every Linear the model
+    configured for int8, rowwise symmetric absmax/127, adding their ``.weight_scale``."""
+    from max.nn.legacy.linear import Linear
+    from max.pipelines.architectures.flux2.weight_adapters import (
+        _bf16_weightdata_to_fp32,
+        _quantize_fp32_to_int8_rowwise,
+    )
+
+    targets = {
+        name
+        for name, weight, layer in language_model._iter_named_weights()
+        if isinstance(layer, Linear)
+        and weight is layer.weight
+        and layer.quant_config is not None
+        and layer.quant_config.is_int8_w8a8
+    }
+    if not targets:
+        return state_dict
+    out = dict(state_dict)
+    for key in targets:
+        v = state_dict.get(key)
+        if v is not None and v.dtype != DType.int8:
+            out.update(_quantize_fp32_to_int8_rowwise(_bf16_weightdata_to_fp32(v), key))
+    return out
+
+
