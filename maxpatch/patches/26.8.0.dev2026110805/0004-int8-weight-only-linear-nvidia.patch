+def _w8_linear_gpu(
+    x: TensorValue,
+    weight: TensorValue,
+    weight_scale: TensorValue,
+    bias: TensorValue | None = None,
+) -> TensorValue:
+    """Weight-only int8 (W8A16) x @ weight.T on GPUs without the Apple int8 MMA (maxpatch).
+
+    The ``w8_linear`` custom op (maxpatch/kernels/w8, installed beside this package or found
+    via $MAX_W8_KERNELS) streams the int8 weights and dequantizes in registers: activations
+    stay bf16, so this is weight-only int8 with the same per-output-channel scales.
+    """
+    import os
+    from pathlib import Path
+
+    from max.graph import Graph, TensorType
+
+    g = Graph.current
+    if not getattr(g, "_maxpatch_w8_loaded", False):
+        pkg = os.environ.get("MAX_W8_KERNELS") or str(
+            Path(__file__).resolve().parents[2] / "_maxpatch_kernels" / "w8"
+        )
+        g._import_kernels([Path(pkg)])
+        g._maxpatch_w8_loaded = True
+    k = x.shape[-1]
+    n = weight.shape[0]
+    x2 = x if x.rank == 2 else ops.reshape(x, (-1, k))
+    if x2.dtype != DType.bfloat16:
+        x2 = ops.cast(x2, DType.bfloat16)
+    scale = ops.cast(ops.reshape(weight_scale, (n,)), DType.float32)
+    out = ops.custom(
+        "w8_linear",
+        device=x.device,
+        values=[x2, weight, scale],
+        out_types=[TensorType(DType.bfloat16, [x2.shape[0], n], device=x.device)],
+    )[0].tensor
+    if bias is not None:
+        out = out + bias
+    if x.rank != 2:
+        out = ops.reshape(out, (*x.shape[:-1], n))
+    return out
+
+
