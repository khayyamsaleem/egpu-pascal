#!/bin/sh
# Open an interactive chat against whatever `local-gpu` is serving.
#
# Exists because the Ghostty window has to be launched as `open -na Ghostty.app --args
# --command=<one shell string>`; a single script path keeps the quoting out of that layer.
# The chat client reads stdin and needs a real terminal, so it is exec'd (not redirected):
# only the environment probe and any stderr go to the log file, stdout stays on the tty.
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd) || exit 1
cd "$here" || exit 1

log=/tmp/gpu-chat-window.log
{
    date
    printf 'cwd=%s user=%s tty=%s\n' "$PWD" "$(id -un)" "$(tty 2>&1)"
    printf 'PATH=%s\n' "$PATH"
    printf 'python3=%s (%s)\n' "$(command -v python3)" "$(python3 -V 2>&1)"
    printf 'card: %s\n' "$(bin/local-gpu status 2>&1 | tr '\n' '|')"
} > "$log" 2>&1

exec ./bin/local-gpu chat "$@"
